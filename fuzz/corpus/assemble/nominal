# nominal.bsr - a healthy bench run from a single drive controller.
#
# One session that opens cleanly, declares two channels, records samples,
# steps through its state machine, logs one warning, and closes. This is the
# baseline every other example is compared against.
#
# Assemble with:  blackspan assemble examples/nominal.bsr --out examples/nominal.bsp

device 0x00A10001
session 1
ts 1000000
tick 1000

session-begin class=17 fw=2.4.11 epoch=3 label="drive-a1 bench run"

schema id=1 name=motor fields=rpm:u16,current_ma:i16,temp_c:i8
schema id=2 name=bus fields=volts:f32,fault_bits:u32

# Spin-up: the drive leaves idle and ramps.
state from=0 to=1 cause=1
samples channel=1 delta=0
  row 1200 850 41
  row 1210 860 41
  row 1250 910 42
end
samples channel=2 delta=0
  row 48.2 0
  row 48.15 0
end

# Load step: a config change raises the current limit, then the drive runs.
state from=1 to=2 cause=2
config param=12 old=100 new=140
marker kind=2 text="load step applied"
samples channel=1 delta=0
  row 1290 980 44
  row 1305 1010 45
end
samples channel=2 delta=0
  row 47.9 0
end

checkpoint id=1 bytes=8192

# The current limit is approached but not tripped; the run continues.
fault code=0x0104 severity=warning subsystem=2 detail="current limit approached"
samples channel=1 delta=0
  row 1180 700 45
end

# Ramp down and close.
state from=2 to=1 cause=3
state from=1 to=0 cause=4
derived id=1 primary=1 name="power_w" expr="rpm * 0.001 * current_ma"
export format=text sections=0xffff
session-end reason=0
